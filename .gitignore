# ==============================================================================
# .gitignore for C Project
# ==============================================================================

# Object files & compiled libraries
*.o
*.obj
*.so
*.dylib
*.dll
*.a

# Executables & build output directories
bin/
build/
obj/
*.out
myps
yaps

# Debugging and profiling symbols
*.dSYM/
*.su
*.idb
*.pdb
gmon.out

# Dependency files generated by compiler
*.d

# Operating System temporary and metadata files
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo

# IDE and Editor configuration directories
.vscode/
.vs/
.idea/
*.sublime-project
*.sublime-workspace
.project
.cproject
.settings/

# Guide documentation
FIVE_DAY_GUIDE.md
